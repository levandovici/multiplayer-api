<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # servers.php moved to /servers/index.php — redirect old links
    RewriteRule ^servers\.php$ /servers/ [R=301,L]

    RewriteCond %{REQUEST_URI} !^/php/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

<Files ".env">
    Order allow,deny
    Deny from all
</Files>

<Files ".user.ini">
    Order allow,deny
    Deny from all
</Files>

# Protect JSON files from direct access
<Files "*.json">
    Order allow,deny
    Deny from all
</Files>

# Allow access to log files for debugging
<Files "*.log">
    Order allow,deny
    Deny from all
</Files>

<IfModule mod_headers.c>
    # --- No cache for all dynamic pages (index.php and every other PHP/HTML page) ---
    <FilesMatch "\.(php|html?|xml|txt|webmanifest)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>

    # Static assets may be cached for a week
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|css|js|woff2?|zip)$">
        Header always set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # Prevent JSON files from being served
    <FilesMatch "\.json$">
        Header always set X-Content-Type-Options nosniff
        Header always set X-Frame-Options DENY
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # PHP pages are served as text/html — never cache them
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 0 seconds"
    # Static assets
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/gif "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/x-icon "access plus 7 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2 "access plus 7 days"
    ExpiresByType application/zip "access plus 7 days"
</IfModule>

# Disable ETag so stale cached copies are never validated as fresh
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None
